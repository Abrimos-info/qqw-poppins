{{#if purchase_count}}
    {{# if purchase_count.supplier }}
        <p class="index-list-element purchase-supplier-text">
            <a href="{{ url view="search" collection="contracts" classification="purchase" proveedor=id}}" title="{{_ "Proveedor en {count} contrato(s) por un total de {amount}" count=(format_number purchase_count.supplier) amount=(format_number purchase_amount.supplier)}}">
                {{{ get_classification_icon "purchase" undefined undefined }}}
                {{_ "Proveedor en {count} compra(s) por un total de" count=(format_number purchase_count.supplier)}} <i class="fas fa-dollar-sign"></i> {{{format_amount purchase_amount.supplier}}}
                {{#if membership_name}} {{_ "con {name}" name=membership_name}}{{/if}}
            </a>
        </p>
    {{/if}}
    {{# if purchase_count.buyer }}
        <p class="index-list-element purchase-buyer-text">
            <a href="{{ url view="search" collection="contracts" classification="purchase" dependencia=id}}" title="{{_ "Comprador en {count} contrato(s) por un total de {amount}" count=(format_number purchase_count.buyer) amount=(format_number purchase_amount.buyer)}}">
                {{{ get_classification_icon "purchase" undefined undefined }}}
                {{_ "Comprador en {count} compra(s) por un total de" count=(format_number purchase_count.buyer)}} <i class="fas fa-dollar-sign"></i> {{{format_amount purchase_amount.buyer}}}
                {{#if membership_name}} {{_ "con {name}" name=membership_name}}{{/if}}

            </a>
        </p>
    {{/if}}
    {{# if purchase_count.product }}
        <p class="index-list-element purchase-buyer-text">
            <a href="{{ url view="search" collection="contracts" classification="purchase" producto=id}}" title="{{_ "Comprador en {count} contrato(s) por un total de {amount}" count=(format_number purchase_count.product) amount=(format_number purchase_amount.product)}}">
                {{{ get_classification_icon "purchase" undefined undefined }}}
                {{_ "{count} compras ({quantity} unidades)" count=(format_number purchase_count.product) quantity=(format_number purchase_quantity.product)}}
                {{_ "por un total de"}} <i class="fas fa-dollar-sign"></i>{{format_amount purchase_amount.product "MXN"}} {{_ "entre"}}
                {{ moment first_purchase_date "Y" }}  {{_ "y"}} {{ moment last_purchase_date "Y" }}
            </a>
        </p>
    {{/if}}
    {{!-- {{# if purchase_count.area }}
        <p class="index-list-element purchase-buyer-text">
            <a href="{{ url view="search" collection="contracts" classification="purchase" dependencia=id}}" title="Comprador en {{format_number purchase_count.area}} contrato(s) por un total de {{format_number purchase_amount.area}}">
                {{{ get_classification_icon "purchase" undefined undefined }}}
                Comprador en {{format_number purchase_count.area}} compra(s) por un total de <i class="fas fa-dollar-sign"></i> {{{format_amount purchase_amount.area}}}
                {{#if membership_name}} {{_ "con {name}" name=membership_name}}{{/if}}

            </a>
        </p>
    {{/if}} --}}
{{/if}}

{{#if contract_count }}
    {{# if contract_count.supplier }}
        <p class="index-list-element supplier-text">
            <a href="{{ url view="search" collection="contracts" classification="contract" proveedor=id}}" title="{{_ "Proveedor en {count} contrato(s) por un total de {amount}" count=(format_number contract_count.supplier) amount=(format_number contract_amount.supplier)}}">
                {{{ get_classification_icon "contract" undefined undefined }}}
                {{_ "Proveedor en {count} contrato(s) por un total de" count=(format_number contract_count.supplier)}} <i class="fas fa-dollar-sign"></i> {{{format_amount contract_amount.supplier}}}
                {{#if membership_name}} {{_ "con {name}" name=membership_name}}{{/if}}
            </a>
        </p>
    {{/if}}
    {{# if contract_count.buyer }}
        <p class="index-list-element buyer-text">
            <a href="{{ url view="search" collection="contracts" classification="contract" dependencia=id}}" title="{{_ "Comprador en {count} contrato(s) por un total de {amount}" count=(format_number contract_count.buyer) amount=(format_number contract_amount.buyer)}}">
                {{{ get_classification_icon "contract" undefined undefined }}}
                {{_ "Comprador en {count} contrato(s) por un total de" count=(format_number contract_count.buyer)}} <i class="fas fa-dollar-sign"></i> {{{format_amount contract_amount.buyer}}}
                {{#if membership_name}} {{_ "con {name}" name=membership_name}}{{/if}}

            </a>
        </p>
    {{/if}}
    {{# if contract_count.funder }}
        <p class="index-list-element funder-text">
            <a href="{{ url view="search" collection="contracts" classification="contract" financiador=id}}" title="{{_ "Financiador en {count} contrato(s) por un total de {amount}" count=(format_number contract_count.funder) amount=(format_number contract_amount.funder)}}">
                {{{ get_classification_icon "contract" undefined undefined }}}
                {{_ "Financiador en {count} contrato(s) por un total de" count=(format_number contract_count.funder)}} <i class="fas fa-dollar-sign"></i> {{{format_amount contract_amount.funder}}}
                {{#if membership_name}} {{_ "con {name}" name=membership_name}}{{/if}}
            </a>
        </p>
    {{/if}}
    {{# if contract_count.area }}
        {{ get_classification_name type result.classification result.subclassification result.govLevel }}
        {{!-- <p class="index-list-element area-text">
            <a href="{{ url view="search" collection="contracts" classification="contract" country=id}}" title="{{format_number contract_count}} contrato(s) por un total de {{format_number contract_amount}}">
            {{{ get_classification_icon "contract" undefined undefined }}}
                {{format_number contract_count.area}} contrato(s) por un total de <i class="fas fa-dollar-sign"></i> {{{format_amount contract_amount.area}}}
            {{#if membership_name}} {{_ "con {name}" name=membership_name}}{{/if}}
            </a>
        </p> --}}
    {{/if}}
{{else}}
    {{#if purchase_count}}
    {{else}}
        {{ get_classification_name type result.classification result.subclassification result.govLevel }}

    {{/if}}
{{/if}}