<section>
  <div class="container error-template">
    <div class="row">
      <div class="col-lg-6 d-flex flex-wrap align-content-center">
        <div class="col-lg-12">
          {{#if notFound}}
          <h1>{{{_ "No encontramos esta página."}}}</h1>
          <p><strong>{{{_ "Puede que el enlace esté mal escrito o que la página ya no exista."}}}</strong></p>
          {{else if unavailable}}
          <h1>{{{_ "El servicio no está disponible en este momento."}}}</h1>
          <p><strong>{{{_ "Estamos teniendo problemas para consultar los datos. Reintenta en unos minutos."}}}</strong></p>
          {{else}}
          <h1>{{{_ "Nos vamos a recuperar de esta."}}}</h1>
          <p><strong>{{{_ "Por favor, refresca la página con F5 o vuelve atrás y reintenta."}}}</strong></p>
          {{/if}}
          <p>{{{_ "Error:"}}} {{status}}</p>
          <p>{{{_ "Si el error persiste, <a href='{url}'>contáctanos</a> con los detalles del error." url=(url view="contacto" subject=(_ "Mensaje desde página de error")) }}}</p>
        </div>
        <div class="col-lg-12 mt-3">
          <h5>{{{_ "¿Cómo puedes seguir?"}}}</h5>
          <ul>
            <li>
              {{{_ "Si estás investigando algo en QQW, utiliza nuestro <a class='' href='{url}'>buscador</a>" url=(url view="buscador")}}}.
            </li>
            <li>
              {{{_ "Si quieres saber más sobre QQW, visita la sección <a href='{url}'>Sobre QQW</a>" url=(url view="sobre-qqw")}}}.
            </li>
            <li>
              {{{_ "O <a href='{url}'>vuelve al inicio</a>" url=(url view="home")}}}.
            </li>
          </ul>
        </div>
      </div>
      <div class="col-lg-6 d-flex flex-wrap align-content-center">
        <img class="img-fluid engranes" src="/images/engranes.png" alt="">
      </div>
    </div>
  </div>
</section>
